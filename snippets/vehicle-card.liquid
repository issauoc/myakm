{%- comment -%}
  Renders exactly one vehicle listing card for the `vehicle` object passed in.
  Called as: {% render 'vehicle-card', vehicle: product, compare_label: compare_label,
                                        wa_label: wa_label, call_label: call_label,
                                        show_verified: show_verified %}

  `render` gives this snippet its own isolated variable scope, so every value
  used below is derived only from the `vehicle` parameter passed in by the
  caller for THIS specific card — there is no way for it to read a stale or
  shared product from elsewhere in the page. Only `vehicle`, `compare_label`,
  `wa_label`, `call_label`, and `show_verified` exist in this scope besides
  Shopify's global objects (shop, cart, settings, ...).
{%- endcomment -%}

{%- liquid
  assign car_brand    = vehicle.metafields.car_details.brand    | default: vehicle.vendor
  assign car_year     = vehicle.metafields.car_details.year     | default: ''
  assign car_mileage  = vehicle.metafields.car_details.mileage  | default: ''
  assign car_location = vehicle.metafields.car_details.location | default: ''
  assign car_phone    = vehicle.metafields.car_details.phone    | default: ''
  assign car_whatsapp = vehicle.metafields.car_details.whatsapp | default: car_phone
  assign car_verified = vehicle.metafields.car_details.verified | default: false
  assign car_dealer   = vehicle.metafields.car_details.dealer_name | default: vehicle.vendor

  assign _mf = vehicle.metafields.shopify["item-condition"].value
  assign car_condition = ''
  if _mf.label.value != blank
    assign car_condition = _mf.label.value
  elsif _mf.name.value != blank
    assign car_condition = _mf.name.value
  elsif _mf.first.label.value != blank
    assign car_condition = _mf | map: 'label' | map: 'value' | join: ' / '
  elsif _mf.first.name.value != blank
    assign car_condition = _mf | map: 'name' | map: 'value' | join: ' / '
  endif
  if car_condition == blank
    assign car_condition = vehicle.metafields.car_details.condition | default: ''
  endif

  assign _mf = vehicle.metafields.shopify["transmission-type"].value
  assign car_transmission = ''
  if _mf.label.value != blank
    assign car_transmission = _mf.label.value
  elsif _mf.name.value != blank
    assign car_transmission = _mf.name.value
  elsif _mf.first.label.value != blank
    assign car_transmission = _mf | map: 'label' | map: 'value' | join: ' / '
  elsif _mf.first.name.value != blank
    assign car_transmission = _mf | map: 'name' | map: 'value' | join: ' / '
  endif
  if car_transmission == blank
    assign car_transmission = vehicle.metafields.car_details.transmission | default: ''
  endif

  assign _mf = vehicle.metafields.shopify["fuel-supply"].value
  assign car_fuel = ''
  if _mf.label.value != blank
    assign car_fuel = _mf.label.value
  elsif _mf.name.value != blank
    assign car_fuel = _mf.name.value
  elsif _mf.first.label.value != blank
    assign car_fuel = _mf | map: 'label' | map: 'value' | join: ' / '
  elsif _mf.first.name.value != blank
    assign car_fuel = _mf | map: 'name' | map: 'value' | join: ' / '
  endif
  if car_fuel == blank
    assign car_fuel = vehicle.metafields.car_details.fuel_type | default: ''
  endif

  if vehicle.tags contains 'condition:New'
    assign car_condition = 'New'
  elsif vehicle.tags contains 'condition:Used'
    assign car_condition = 'Used'
  endif

  if vehicle.tags contains 'verified' or vehicle.tags contains 'Verified' or vehicle.tags contains 'موثّق'
    assign car_verified = true
  endif

  for tag in vehicle.tags
    if tag contains 'brand:'
      assign car_brand = tag | remove: 'brand:'
      break
    endif
  endfor

  assign car_condition_label = car_condition
  if car_condition == 'New'
    assign car_condition_label = 'جديدة'
  elsif car_condition == 'Used'
    assign car_condition_label = 'مستعملة'
  endif

  assign search_string = car_brand | append: ' ' | append: vehicle.title | append: ' ' | append: car_year | append: ' ' | append: car_location | append: ' ' | append: car_transmission | append: ' ' | append: car_dealer | downcase

  assign car_price = vehicle.price | money_without_trailing_zeros | remove: '.00'

  assign wa_number = car_whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign wa_message_text = 'مرحبًا، شاهدت إعلان ' | append: vehicle.title | append: ' بسعر ' | append: car_price | append: ' وأريد الاستفسار عن تفاصيل السيارة والمعاينة. هل متاحة؟ - ' | append: shop.url | append: vehicle.url
  assign wa_message = wa_message_text | url_encode

  assign card_created = vehicle.created_at | date: '%s'
-%}

<article class="akm-uc-card"
  data-akm-uc-card
  data-product-url="{{ vehicle.url }}"
  data-search="{{ search_string }}"
  data-condition="{{ car_condition | downcase }}"
  data-price="{{ vehicle.price }}"
  data-year="{{ car_year | default: 0 }}"
  data-created="{{ card_created }}">

  <div class="akm-uc-card__media">
    {%- if vehicle.tags contains 'hot' or vehicle.tags contains 'Hot' -%}
      <span class="akm-uc-badge akm-uc-badge--hot">عرض مميز</span>
    {%- elsif vehicle.tags contains 'featured' or vehicle.tags contains 'Featured' -%}
      <span class="akm-uc-badge akm-uc-badge--featured">مميز</span>
    {%- endif -%}

    {%- if vehicle.compare_at_price > vehicle.price -%}
      {%- assign discount_percent = vehicle.compare_at_price | minus: vehicle.price | times: 100 | divided_by: vehicle.compare_at_price -%}
      <span class="akm-uc-badge akm-uc-badge--discount">-{{ discount_percent }}%</span>
    {%- endif -%}

    {%- if vehicle.featured_image -%}
      <img class="akm-uc-card__img"
           src="{{ vehicle.featured_image | image_url: width: 700 }}"
           alt="{{ vehicle.title | escape }}"
           width="700"
           height="525"
           loading="lazy">
    {%- else -%}
      <div class="akm-uc-card__img akm-uc-card__img--placeholder" role="img" aria-label="{{ vehicle.title | escape }}">
        <span>لا توجد صورة</span>
      </div>
    {%- endif -%}

    <button type="button" class="akm-uc-fav" data-akm-uc-fav aria-pressed="false" aria-label="حفظ {{ vehicle.title | escape }} في المفضلة">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </button>

    <button type="button"
      class="akm-uc-compare-toggle"
      data-akm-uc-compare
      aria-pressed="false"
      data-id="{{ vehicle.id }}"
      data-title="{{ vehicle.title | escape }}"
      data-image="{{ vehicle.featured_image | image_url: width: 200 }}"
      data-price="{{ car_price }} ج.م"
      data-year="{{ car_year | default: '—' }}"
      data-mileage="{{ car_mileage | default: '—' }}"
      data-transmission="{{ car_transmission | default: '—' }}"
      data-fuel="{{ car_fuel | default: '—' }}"
      data-url="{{ vehicle.url }}">
      <span class="akm-uc-compare-toggle__box" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
      </span>
      <span>{{ compare_label }}</span>
    </button>

    {%- if car_condition != blank -%}
      <span class="akm-uc-card__cond akm-uc-card__cond--{{ car_condition | downcase }}">{{ car_condition_label }}</span>
    {%- endif -%}
  </div>

  <div class="akm-uc-card__body">
    <div class="akm-uc-card__head">
      <span class="akm-uc-price">{{ car_price }} ج.م</span>
      {%- if car_verified and show_verified -%}
        <span class="akm-uc-badge akm-uc-badge--verified">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.39 2.43 3.4-.34.82 3.33 3.04 1.6-1.18 3.22 1.18 3.22-3.04 1.6-.82 3.33-3.4-.34L12 22l-2.39-2.43-3.4.34-.82-3.33-3.04-1.6 1.18-3.22L2.35 8.54l3.04-1.6.82-3.33 3.4.34L12 2zm-1.1 14.1l6.4-6.4-1.4-1.4-5 5-2.5-2.5-1.4 1.4 3.9 3.9z"/></svg>
          موثّق
        </span>
      {%- endif -%}
    </div>

    <h3 class="akm-uc-card__title">{{ vehicle.title }}</h3>
    <p class="akm-uc-card__meta">
      {%- if car_verified and show_verified -%}
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.39 2.43 3.4-.34.82 3.33 3.04 1.6-1.18 3.22 1.18 3.22-3.04 1.6-.82 3.33-3.4-.34L12 22l-2.39-2.43-3.4.34-.82-3.33-3.04-1.6 1.18-3.22L2.35 8.54l3.04-1.6.82-3.33 3.4.34L12 2zm-1.1 14.1l6.4-6.4-1.4-1.4-5 5-2.5-2.5-1.4 1.4 3.9 3.9z"/></svg>
      {%- else -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V9l7-5 7 5v12"/><path d="M9 21v-6h6v6"/></svg>
      {%- endif -%}
      <span class="akm-uc-card__meta-label">البائع:</span> {{ car_dealer }}
    </p>

    <ul class="akm-uc-specs">
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>{{ car_year | default: '—' }}</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>{{ car_location | default: '—' }}</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 17l-8-5-8 5"/><path d="M4 7h16v10H4z"/></svg>
        <span>{{ car_mileage | default: '—' }}</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span>{{ car_transmission | default: '—' }}</span>
      </li>
    </ul>

    {%- if car_whatsapp != blank or car_phone != blank -%}
      <div class="akm-uc-card__quick">
        {%- if car_whatsapp != blank -%}
          <a class="akm-uc-iconlink akm-uc-iconlink--wa" href="https://wa.me/{{ wa_number }}?text={{ wa_message }}" target="_blank" rel="noopener" aria-label="{{ wa_label }} بخصوص {{ vehicle.title | escape }}">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1c-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.5-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.4.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.3 5.2 4.6.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/></svg>
            <span>{{ wa_label }}</span>
          </a>
        {%- endif -%}
        {%- if car_phone != blank -%}
          <a class="akm-uc-iconlink akm-uc-iconlink--call" href="tel:{{ car_phone }}" aria-label="{{ call_label }} بخصوص {{ vehicle.title | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{{ call_label }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <a class="akm-uc-card__hint" href="{{ vehicle.url }}" data-akm-uc-details aria-label="عرض تفاصيل السيارة - {{ vehicle.title | escape }}">
      عرض تفاصيل السيارة
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</article>
