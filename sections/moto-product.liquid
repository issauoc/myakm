      "label": "رابط صفحة كل الموتوسيكلات",
      "info": "يُستخدم في رابط الرجوع. الافتراضي: المجموعة التي جاء منها العميل."
    },
    { "type": "header", "content": "رسائل الطمأنة (اختياري، سطر واحد لكل رسالة)" },
    { "type": "text", "id": "reassure_1", "label": "رسالة 1", "default": "مساعدة في الترخيص والأوراق" },
    { "type": "text", "id": "reassure_2", "label": "رسالة 2", "default": "معاينة واستلام من الفرع أو توصيل" },
    { "type": "text", "id": "reassure_3", "label": "رسالة 3" },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "رقم واتساب للاستفسار",
      "info": "اتركه فارغًا لإخفاء رابط الاستفسار. مثال: 201000000000"
    },
    { "type": "color", "id": "accent", "label": "لون التمييز", "default": "#ff5a1f" }
  ]
}
