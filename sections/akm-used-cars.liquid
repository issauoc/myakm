    },
    {
      "type": "text",
      "id": "heading",
      "label": "عنوان الصفحة",
      "default": "سيارات مستعملة للبيع في مصر"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "النص التعريفي",
      "default": "تصفح سيارات مستعملة معروضة من بائعين موثوقين في مصر، وتواصل مباشرة بدون وسيط أو خطوات شراء إلكترونية."
    },
    {
      "type": "text",
      "id": "stat_dealers",
      "label": "إحصائية البائعين",
      "default": "120+"
    },
    {
      "type": "header",
      "content": "ترويسة قسم السيارات"
