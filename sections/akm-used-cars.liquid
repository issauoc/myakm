  }
  .akm-uc .akm-uc-comparebar__item img { width: 34px; height: 34px; border-radius: 6px; object-fit: cover; }
  .akm-uc .akm-uc-comparebar__item span {
    color: #fff; font-size: 12.5px; font-weight: 600; max-width: 130px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
