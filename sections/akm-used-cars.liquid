    border-top: 1px solid rgba(255,255,255,.1);
    box-shadow: 0 -8px 24px -8px rgba(0,0,0,.3);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .akm-uc .akm-uc-comparebar[hidden] { display: none; }
  .akm-uc .akm-uc-comparebar__inner {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    padding: 12px 16px;
  }
  .akm-uc .akm-uc-comparebar__list { display: flex; gap: 8px; flex: 1; flex-wrap: wrap; min-width: 200px; }
  .akm-uc .akm-uc-comparebar__item {
    display: flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 10px;
