  .akm-uc .akm-uc-comparebar__item button:hover { background: var(--akm-uc-accent); }
  .akm-uc .akm-uc-comparebar__item button svg { width: 11px; height: 11px; }
  .akm-uc .akm-uc-comparebar__actions { display: flex; align-items: center; gap: 8px; }
  .akm-uc .akm-uc-comparebar .akm-uc-btn-ghost { background: transparent; border-color: rgba(255,255,255,.2); color: #fff; }
  .akm-uc .akm-uc-comparebar .akm-uc-btn-ghost:hover { background: rgba(255,255,255,.08); }

  /* ---------- COMPARE MODAL ---------- */
  .akm-uc .akm-uc-comparemodal { position: fixed; inset: 0; z-index: 50; }
  .akm-uc .akm-uc-comparemodal[hidden] { display: none; }
  .akm-uc .akm-uc-comparemodal__backdrop { position: absolute; inset: 0; background: rgba(15,23,42,.6); backdrop-filter: blur(2px); border: 0; cursor: pointer; }
  .akm-uc .akm-uc-comparemodal__panel {
    position: relative;
    max-width: 960px;
    margin: 40px auto;
    max-height: calc(100vh - 80px);
    background: #fff;
    border-radius: var(--akm-uc-radius-lg);
    box-shadow: var(--akm-uc-shadow-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .akm-uc .akm-uc-comparemodal__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 18px; border-bottom: 1px solid var(--akm-uc-line);
  }
  .akm-uc .akm-uc-comparemodal__header h2 { margin: 0; font-size: 18px; font-weight: 800; }
  .akm-uc .akm-uc-iconbtn {
    width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--akm-uc-line);
    background: #fff; color: var(--akm-uc-ink-soft); cursor: pointer;
