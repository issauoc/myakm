  }
  .akm-uc .akm-uc-iconbtn:hover { background: var(--akm-uc-line-soft); }
  .akm-uc .akm-uc-iconbtn svg { width: 18px; height: 18px; }
  .akm-uc .akm-uc-comparemodal__body { padding: 16px 18px 20px; overflow: auto; }

  .akm-uc .akm-uc-comparetable { width: 100%; border-collapse: collapse; min-width: 480px; }
  .akm-uc .akm-uc-comparetable th, .akm-uc .akm-uc-comparetable td {
    padding: 10px 12px; text-align: center; border-bottom: 1px solid var(--akm-uc-line-soft); vertical-align: middle;
  }
  .akm-uc .akm-uc-comparetable th:first-child, .akm-uc .akm-uc-comparetable td:first-child {
    text-align: right; color: var(--akm-uc-ink-mute); font-size: 12.5px; font-weight: 700; white-space: nowrap;
  }
  .akm-uc .akm-uc-comparetable img { width: 100%; max-width: 140px; aspect-ratio: 4/3; object-fit: cover; border-radius: 10px; margin: 0 auto; }
  .akm-uc .akm-uc-comparetable .akm-uc-compare-title { font-size: 13.5px; font-weight: 700; margin-top: 8px; display: block; }
  .akm-uc .akm-uc-comparetable .akm-uc-compare-price { font-size: 15px; font-weight: 800; color: var(--akm-uc-accent); }
  .akm-uc .akm-uc-comparetable .akm-uc-compare-remove {
    margin-top: 8px; border: 1px solid var(--akm-uc-line); background: #fff; color: var(--akm-uc-ink-soft);
    font-size: 11.5px; font-weight: 700; padding: 5px 10px; border-radius: var(--akm-uc-radius-pill); cursor: pointer;
  }
  .akm-uc .akm-uc-comparetable .akm-uc-compare-remove:hover { border-color: var(--akm-uc-accent); color: var(--akm-uc-accent); }
  .akm-uc .akm-uc-comparetable .akm-uc-compare-view {
    display: inline-block; margin-top: 8px; font-size: 12px; font-weight: 700; color: var(--akm-uc-call); text-decoration: underline;
  }
  .akm-uc .akm-uc-compareempty { text-align: center; padding: 30px; color: var(--akm-uc-ink-soft); font-size: 14px; }

  /* ---------- RESPONSIVE ---------- */
  @media (min-width: 640px) {
    .akm-uc .akm-uc-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }
  @media (min-width: 768px) {
    .akm-uc .akm-uc-container { padding: 0 32px; }
    .akm-uc .akm-uc-hero { padding: 64px 0 56px; }
    .akm-uc .akm-uc-listings { padding: 40px 0 110px; }
    .akm-uc .akm-uc-filterbar__inner { flex-wrap: nowrap; }
  }
  @media (min-width: 1024px) {
    .akm-uc .akm-uc-grid { grid-template-columns: repeat(3, 1fr); gap: 22px; }
  }
  @media (min-width: 1280px) {
    .akm-uc .akm-uc-grid { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 639px) {
    .akm-uc .akm-uc-filterbar__inner { padding: 8px 12px; gap: 8px; }
    .akm-uc .akm-uc-filterbar__search { flex: 1 1 100%; order: 1; }
    .akm-uc .akm-uc-filterbar__search input { font-size: 16px; }
    .akm-uc .akm-uc-filterbar__chips {
      order: 2; flex: 1 1 100%; flex-wrap: nowrap;
      overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none;
      padding-bottom: 2px; margin: 0 -12px; padding-inline: 12px;
    }
    .akm-uc .akm-uc-filterbar__chips::-webkit-scrollbar { display: none; }
    .akm-uc .akm-uc-chip { flex: 0 0 auto; min-height: 44px; }
    .akm-uc .akm-uc-filterbar__sort { order: 3; flex: 1 1 100%; }
    .akm-uc .akm-uc-filterbar__sort select { width: 100%; min-height: 44px; font-size: 16px; }
    .akm-uc .akm-uc-filterbar__count { order: 4; flex: 1 1 100%; text-align: center; margin-inline-start: 0; }

    .akm-uc .akm-uc-fav { width: 44px; height: 44px; }
    .akm-uc .akm-uc-compare-toggle { min-height: 40px; padding: 8px 14px 8px 10px; }
    .akm-uc .akm-uc-iconlink { min-height: 46px; }
    .akm-uc .akm-uc-btn-ghost, .akm-uc .akm-uc-btn-primary { min-height: 46px; }

    .akm-uc .akm-uc-comparebar__actions { width: 100%; justify-content: space-between; }
    .akm-uc .akm-uc-comparebar__list { max-height: 76px; overflow-y: auto; }

    .akm-uc .akm-uc-comparemodal__panel {
      position: fixed;
      inset: auto 0 0 0;
      margin: 0;
      max-width: none;
      max-height: 88vh;
      border-radius: 20px 20px 0 0;
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .akm-uc .akm-uc-comparemodal__header { padding: 14px 16px; }
    .akm-uc .akm-uc-iconbtn { width: 44px; height: 44px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .akm-uc * { transition-duration: .01ms !important; animation-duration: .01ms !important; }
  }
</style>

<script>
  (function () {
    'use strict';
    var root = document.getElementById('akm-uc-{{ uid }}');
    if (!root || root.dataset.akmUcInit === '1') return;
    root.dataset.akmUcInit = '1';

    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-akm-uc-card]'));
    var grid = root.querySelector('[data-akm-uc-grid]');
    var emptyEl = root.querySelector('[data-akm-uc-empty]');
    var searchInput = root.querySelector('[data-akm-uc-search]');
    var sortSelect = root.querySelector('[data-akm-uc-sort]');
    var conditionChips = Array.prototype.slice.call(root.querySelectorAll('[data-akm-uc-condition]'));
    var countEl = root.querySelector('[data-akm-uc-count]');
    var resetBtn = root.querySelector('[data-akm-uc-reset]');
    var maxCompare = parseInt(root.dataset.maxCompare, 10) || 3;

    var state = { search: '', condition: 'all', sort: 'default' };

    function applyFilters() {
      var s = state.search.trim().toLowerCase();
      var visible = 0;
      cards.forEach(function (card) {
        var matchesSearch = !s || (card.dataset.search || '').toLowerCase().indexOf(s) !== -1;
        var matchesCondition = state.condition === 'all' || card.dataset.condition === state.condition;
        var match = matchesSearch && matchesCondition;
        card.classList.toggle('is-hidden', !match);
        if (match) visible++;
      });

      if (grid && emptyEl) {
        var noResults = visible === 0 && cards.length > 0;
        emptyEl.hidden = !noResults;
        grid.style.display = noResults ? 'none' : '';
      }
      if (countEl) countEl.textContent = visible + ' سيارة';
    }

    function applySort() {
      var sorted = cards.slice();
      if (state.sort === 'price-asc') {
        sorted.sort(function (a, b) { return (+a.dataset.price || 0) - (+b.dataset.price || 0); });
      } else if (state.sort === 'price-desc') {
        sorted.sort(function (a, b) { return (+b.dataset.price || 0) - (+a.dataset.price || 0); });
      } else if (state.sort === 'year-desc') {
        sorted.sort(function (a, b) { return (+b.dataset.year || 0) - (+a.dataset.year || 0); });
      } else {
        sorted.sort(function (a, b) { return (+b.dataset.created || 0) - (+a.dataset.created || 0); });
      }
      sorted.forEach(function (card, i) { card.style.order = i; });
    }

    var debounce;
    if (searchInput) {
      searchInput.addEventListener('input', function () {
        clearTimeout(debounce);
        var val = searchInput.value;
        debounce = setTimeout(function () { state.search = val; applyFilters(); }, 150);
      });
    }

    conditionChips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        conditionChips.forEach(function (c) {
          c.classList.remove('is-active');
          c.setAttribute('aria-pressed', 'false');
        });
        chip.classList.add('is-active');
        chip.setAttribute('aria-pressed', 'true');
        state.condition = chip.dataset.akmUcCondition;
        applyFilters();
      });
    });

    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        state.sort = sortSelect.value;
        applySort();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        state.search = '';
        state.condition = 'all';
        if (searchInput) searchInput.value = '';
        conditionChips.forEach(function (c) {
          var isAll = c.dataset.akmUcCondition === 'all';
          c.classList.toggle('is-active', isAll);
          c.setAttribute('aria-pressed', String(isAll));
        });
        applyFilters();
      });
    }

    root.querySelectorAll('[data-akm-uc-fav]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        var pressed = btn.getAttribute('aria-pressed') === 'true';
        btn.setAttribute('aria-pressed', String(!pressed));
      });
    });

    applySort();
    applyFilters();

    /* ---------- COMPARE WORKFLOW ---------- */
    var compareItems = new Map();
    var compareToggles = Array.prototype.slice.call(root.querySelectorAll('[data-akm-uc-compare]'));
    var compareBar = root.querySelector('[data-akm-uc-comparebar]');
    var compareBarList = root.querySelector('[data-akm-uc-comparebar-list]');
    var compareBarCount = root.querySelector('[data-akm-uc-comparebar-count]');
    var compareBarOpen = root.querySelector('[data-akm-uc-comparebar-open]');
    var compareBarClear = root.querySelector('[data-akm-uc-comparebar-clear]');
    var compareModal = root.querySelector('[data-akm-uc-comparemodal]');
    var compareModalBody = root.querySelector('[data-akm-uc-comparemodal-body]');
    var compareModalCloseEls = root.querySelectorAll('[data-akm-uc-comparemodal-close]');
    var lastFocusedEl = null;

    function svgRemove() {
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
    }

    function findToggle(id) {
      return compareToggles.filter(function (t) { return t.dataset.id === id; })[0];
    }

    function setToggleState(id, active) {
      var toggle = findToggle(id);
      if (!toggle) return;
      toggle.setAttribute('aria-pressed', String(active));
      var card = toggle.closest('[data-akm-uc-card]');
      if (card) card.classList.toggle('is-comparing', active);
    }

    function renderCompareBar() {
      if (!compareBar || !compareBarList || !compareBarCount || !compareBarOpen) return;
      compareBarList.innerHTML = '';
      compareItems.forEach(function (item) {
        var chip = document.createElement('div');
        chip.className = 'akm-uc-comparebar__item';
        chip.setAttribute('role', 'listitem');
        chip.innerHTML =
          '<img src="' + item.image + '" alt="" loading="lazy">' +
          '<span>' + item.title + '</span>' +
          '<button type="button" aria-label="إزالة ' + item.title + ' من المقارنة">' + svgRemove() + '</button>';
        chip.querySelector('button').addEventListener('click', function () { removeFromCompare(item.id); });
        compareBarList.appendChild(chip);
      });
      compareBarCount.textContent = '(' + compareItems.size + ')';
      compareBarOpen.disabled = compareItems.size < 2;
      compareBar.hidden = compareItems.size === 0;
    }

    function addToCompare(data) {
      if (compareItems.size >= maxCompare) {
        if (countEl) {
          var prevText = countEl.textContent;
          countEl.textContent = 'يمكنك مقارنة ' + maxCompare + ' سيارات كحد أقصى';
          setTimeout(function () { countEl.textContent = prevText; }, 2200);
        }
        return false;
      }
      compareItems.set(data.id, data);
      setToggleState(data.id, true);
      renderCompareBar();
      return true;
    }

    function removeFromCompare(id) {
      compareItems.delete(id);
      setToggleState(id, false);
      renderCompareBar();
      if (compareItems.size === 0) closeCompareModal();
      else if (!compareModal.hidden) renderCompareModal();
    }

    compareToggles.forEach(function (toggle) {
      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        var id = toggle.dataset.id;
        var pressed = toggle.getAttribute('aria-pressed') === 'true';
        if (pressed) {
          removeFromCompare(id);
        } else {
          addToCompare({
            id: id,
            title: toggle.dataset.title,
            image: toggle.dataset.image,
            price: toggle.dataset.price,
            year: toggle.dataset.year,
            mileage: toggle.dataset.mileage,
            transmission: toggle.dataset.transmission,
            fuel: toggle.dataset.fuel,
            url: toggle.dataset.url
          });
        }
      });
    });

    if (compareBarClear) {
      compareBarClear.addEventListener('click', function () {
        Array.from(compareItems.keys()).forEach(removeFromCompare);
      });
    }

    function renderCompareModal() {
      if (!compareModalBody) return;
      if (compareItems.size === 0) {
        compareModalBody.innerHTML = '<p class="akm-uc-compareempty">لا توجد سيارات محددة للمقارنة بعد.</p>';
        return;
      }
      var items = Array.from(compareItems.values());
      var rows = [
        { label: '', key: 'header' },
        { label: 'السعر', key: 'price' },
        { label: 'سنة الصنع', key: 'year' },
        { label: 'الممشى', key: 'mileage' },
        { label: 'ناقل الحركة', key: 'transmission' },
        { label: 'نوع الوقود', key: 'fuel' },
        { label: '', key: 'actions' }
      ];

      var html = '<table class="akm-uc-comparetable"><tbody>';
      rows.forEach(function (row) {
        html += '<tr><th scope="row">' + row.label + '</th>';
        items.forEach(function (item) {
          if (row.key === 'header') {
            html += '<td><img src="' + item.image + '" alt=""><span class="akm-uc-compare-title">' + item.title + '</span></td>';
          } else if (row.key === 'price') {
            html += '<td class="akm-uc-compare-price">' + item.price + '</td>';
          } else if (row.key === 'actions') {
            html += '<td>' +
              '<a class="akm-uc-compare-view" href="' + item.url + '">عرض السيارة</a><br>' +
              '<button type="button" class="akm-uc-compare-remove" data-remove-id="' + item.id + '">إزالة</button>' +
              '</td>';
          } else {
            html += '<td>' + item[row.key] + '</td>';
          }
        });
        html += '</tr>';
      });
      html += '</tbody></table>';
      compareModalBody.innerHTML = html;

      compareModalBody.querySelectorAll('[data-remove-id]').forEach(function (btn) {
        btn.addEventListener('click', function () { removeFromCompare(btn.dataset.removeId); });
      });
    }

    function openCompareModal(triggerEl) {
      if (!compareModal || compareItems.size === 0) return;
      lastFocusedEl = triggerEl || document.activeElement;
      renderCompareModal();
      compareModal.hidden = false;
      document.body.style.overflow = 'hidden';
      var closeBtn = compareModal.querySelector('.akm-uc-iconbtn');
      if (closeBtn) closeBtn.focus();
    }

    function closeCompareModal() {
      if (!compareModal || compareModal.hidden) return;
      compareModal.hidden = true;
      document.body.style.overflow = '';
      if (lastFocusedEl) lastFocusedEl.focus();
    }

    if (compareBarOpen) {
      compareBarOpen.addEventListener('click', function () { openCompareModal(compareBarOpen); });
    }
    compareModalCloseEls.forEach(function (el) {
      el.addEventListener('click', closeCompareModal);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && compareModal && !compareModal.hidden) closeCompareModal();
    });
    if (compareModal) {
      compareModal.addEventListener('keydown', function (e) {
        if (e.key !== 'Tab') return;
        var focusable = compareModal.querySelectorAll('button, a[href], select, input');
        if (!focusable.length) return;
        var first = focusable[0];
        var last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    }
  })();
</script>

{% schema %}
{
