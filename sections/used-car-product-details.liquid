  /* Compact tech specs */
  .akm-used-car-product .akm-tech-compact {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .akm-used-car-product .akm-tech-row-compact {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 12px;
    background: var(--akm-spec-bg);
    border: 1px solid var(--akm-border);
    border-radius: 10px;
    font-size: 13px;
    gap: 12px;
  }
  .akm-used-car-product .akm-tech-label-compact {
    color: var(--akm-muted);
    font-weight: 600;
    flex-shrink: 0;
  }
  .akm-used-car-product .akm-tech-value-compact {
    color: var(--akm-text);
    font-weight: 700;
    text-align: end;
    word-break: break-word;
  }

  /* Compact features */
  .akm-used-car-product .akm-features-compact {
