    {%- comment %} ===== Features collection ===== {%- endcomment %}
    {%- liquid
      assign features_collected = ''

      if m_features_category != blank
        assign farr_category = m_features_category | split: '،'
        for f in farr_category
          assign fc = f | strip
          if fc != blank
            assign features_collected = features_collected | append: fc | append: '|||'
          endif
        endfor
      endif

      if m_features != blank
        assign mf_type = m_features.type
        if mf_type contains 'list'
          for f in m_features.value
            assign fc = f | strip
            if fc != blank
              assign features_collected = features_collected | append: fc | append: '|||'
            endif
          endfor
        else
          assign fstr = m_features.value | strip
          if fstr contains ','
            assign farr = fstr | split: ','
          else
            assign farr = fstr | newline_to_br | split: '<br />'
          endif
          for f in farr
            assign fc = f | strip | replace: '<br>', '' | replace: '<br/>', '' | replace: '<br />', ''
            if fc != blank
              assign features_collected = features_collected | append: fc | append: '|||'
            endif
          endfor
        endif
      endif

      for tag in product.tags
        assign tl = tag | downcase | strip
        assign skip = false
        if tl == 'used cars' or tl == 'used-car' or tl == 'used car' or tl == 'used' or tl == 'new' or tl == 'سيارات مستعملة' or tl == 'مستعمل' or tl == 'مستعملة'
          assign skip = true
        endif
        if tag contains ':'
          assign skip = true
        endif
        unless skip
          assign features_collected = features_collected | append: tag | append: '|||'
        endunless
      endfor

      assign features_array = features_collected | split: '|||'
    -%}

