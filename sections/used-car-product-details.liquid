{% comment %}
  ============================================================
  AKM — Used Car Product Details
  File: sections/used-car-product-details.liquid
  Dedicated template for used cars only.
  No cart, no checkout, no product form, no inventory language.
  All CSS scoped under .akm-used-car-product
  ============================================================
{% endcomment %}

{%- liquid
  assign cd = product.metafields.car_details

  assign m_year         = cd.year
  assign m_mileage      = cd.mileage
  assign m_engine       = cd.engine
  assign m_location     = cd.location
  assign m_phone        = cd.phone
  assign m_whatsapp     = cd.whatsapp
  assign m_features     = cd.features

  assign m_condition_mf = product.metafields.shopify["item-condition"].value | default: product.metafields.shopify.item_condition.value
  assign m_condition = m_condition_mf | map: 'label' | join: ' / '
  if m_condition == blank
    assign m_condition = m_condition_mf | map: 'name' | join: ' / '
  endif
  if m_condition == blank
    assign m_condition = m_condition_mf | join: ' / '
  endif
  if m_condition == blank and product.metafields.shopify["item-condition"].value.label != blank
    assign m_condition = product.metafields.shopify["item-condition"].value.label
  endif
  if m_condition == blank and product.metafields.shopify["item-condition"].value.name != blank
    assign m_condition = product.metafields.shopify["item-condition"].value.name
  endif
  if m_condition == blank
    assign m_condition = cd.condition
  endif

  assign m_transmission_mf = product.metafields.shopify["transmission-type"].value | default: product.metafields.shopify.transmission_type.value
  assign m_transmission = m_transmission_mf | map: 'label' | join: ' / '
  if m_transmission == blank
    assign m_transmission = m_transmission_mf | map: 'name' | join: ' / '
  endif
  if m_transmission == blank
    assign m_transmission = m_transmission_mf | join: ' / '
  endif
  if m_transmission == blank and product.metafields.shopify["transmission-type"].value.label != blank
    assign m_transmission = product.metafields.shopify["transmission-type"].value.label
  endif
  if m_transmission == blank and product.metafields.shopify["transmission-type"].value.name != blank
    assign m_transmission = product.metafields.shopify["transmission-type"].value.name
  endif
  if m_transmission == blank
    assign m_transmission = cd.transmission
  endif

  assign m_fuel_mf = product.metafields.shopify["fuel-supply"].value | default: product.metafields.shopify.fuel_supply.value
  assign m_fuel = m_fuel_mf | map: 'label' | join: ' / '
  if m_fuel == blank
    assign m_fuel = m_fuel_mf | map: 'name' | join: ' / '
  endif
  if m_fuel == blank
    assign m_fuel = m_fuel_mf | join: ' / '
  endif
  if m_fuel == blank and product.metafields.shopify["fuel-supply"].value.label != blank
    assign m_fuel = product.metafields.shopify["fuel-supply"].value.label
  endif
  if m_fuel == blank and product.metafields.shopify["fuel-supply"].value.name != blank
    assign m_fuel = product.metafields.shopify["fuel-supply"].value.name
  endif
  if m_fuel == blank
    assign m_fuel = cd.fuel_type
  endif

  assign m_drive_mf = product.metafields.shopify["drive-type"].value | default: product.metafields.shopify.drive_type.value
  assign m_drive = m_drive_mf | map: 'label' | join: ' / '
  if m_drive == blank
    assign m_drive = m_drive_mf | map: 'name' | join: ' / '
  endif
  if m_drive == blank
    assign m_drive = m_drive_mf | join: ' / '
  endif
  if m_drive == blank and product.metafields.shopify["drive-type"].value.label != blank
    assign m_drive = product.metafields.shopify["drive-type"].value.label
  endif
  if m_drive == blank and product.metafields.shopify["drive-type"].value.name != blank
    assign m_drive = product.metafields.shopify["drive-type"].value.name
  endif
  if m_drive == blank
    assign m_drive = cd.drive_type
  endif

  assign m_ext_color_mf = product.metafields.shopify["body-color"].value | default: product.metafields.shopify.body_color.value
  assign m_ext_color = m_ext_color_mf | map: 'label' | join: ' / '
  if m_ext_color == blank
    assign m_ext_color = m_ext_color_mf | map: 'name' | join: ' / '
  endif
  if m_ext_color == blank
    assign m_ext_color = m_ext_color_mf | join: ' / '
  endif
  if m_ext_color == blank and product.metafields.shopify["body-color"].value.label != blank
    assign m_ext_color = product.metafields.shopify["body-color"].value.label
  endif
  if m_ext_color == blank and product.metafields.shopify["body-color"].value.name != blank
    assign m_ext_color = product.metafields.shopify["body-color"].value.name
  endif
  if m_ext_color == blank
    assign m_ext_color = cd.exterior_color
  endif

  assign m_int_color_mf = product.metafields.shopify["upholstery-color"].value | default: product.metafields.shopify.upholstery_color.value
  assign m_int_color = m_int_color_mf | map: 'label' | join: ' / '
  if m_int_color == blank
    assign m_int_color = m_int_color_mf | map: 'name' | join: ' / '
  endif
  if m_int_color == blank
    assign m_int_color = m_int_color_mf | join: ' / '
  endif
  if m_int_color == blank and product.metafields.shopify["upholstery-color"].value.label != blank
    assign m_int_color = product.metafields.shopify["upholstery-color"].value.label
  endif
  if m_int_color == blank and product.metafields.shopify["upholstery-color"].value.name != blank
    assign m_int_color = product.metafields.shopify["upholstery-color"].value.name
  endif
  if m_int_color == blank
    assign m_int_color = cd.interior_color
  endif

  assign m_features_category_mf = product.metafields.shopify["vehicle-features"].value | default: product.metafields.shopify.vehicle_features.value
  assign m_features_category = m_features_category_mf | map: 'label' | join: '، '
  if m_features_category == blank
    assign m_features_category = m_features_category_mf | map: 'name' | join: '، '
  endif
  if m_features_category == blank
    assign m_features_category = m_features_category_mf | join: '، '
  endif

  if m_phone == blank and section.settings.default_phone != blank
    assign m_phone = section.settings.default_phone
  endif
  if m_whatsapp == blank and section.settings.default_whatsapp != blank
    assign m_whatsapp = section.settings.default_whatsapp
  endif

  assign has_quick_specs = false
  if m_year         != blank
    assign has_quick_specs = true
  endif
  if m_mileage      != blank
    assign has_quick_specs = true
  endif
  if m_transmission != blank
    assign has_quick_specs = true
  endif
  if m_fuel         != blank
    assign has_quick_specs = true
  endif
  if m_location     != blank
    assign has_quick_specs = true
  endif
  if m_condition    != blank
    assign has_quick_specs = true
  endif

  assign has_tech = false
  if m_engine    != blank
    assign has_tech = true
  endif
  if m_drive     != blank
    assign has_tech = true
  endif
  if m_ext_color != blank
    assign has_tech = true
  endif
  if m_int_color != blank
    assign has_tech = true
  endif

  assign whatsapp_clean = m_whatsapp | strip | replace: ' ', '' | replace: '-', '' | replace: '+', '' | replace: '(', '' | replace: ')', ''
  assign phone_clean    = m_phone | strip | replace: ' ', '' | replace: '-', ''

  assign wa_msg_inquiry = 'مرحبًا، أريد الاستفسار عن السيارة: ' | append: product.title
  assign wa_msg_book    = 'مرحبًا، أريد حجز معاينة للسيارة: '   | append: product.title
  assign wa_inquiry_enc = wa_msg_inquiry | url_encode
  assign wa_book_enc    = wa_msg_book    | url_encode

  assign listing_url = section.settings.listing_url
  if listing_url == blank
    assign listing_url = '/pages/سيارات-مستعملة'
  endif

  assign jsonld_price = product.price | money_without_currency | replace: ',', '' | strip
  assign jsonld_desc  = product.description | strip_html | strip | truncate: 500
-%}

<style>
  .akm-used-car-product {
    --akm-bg:        {{ section.settings.page_bg }};
    --akm-card:      {{ section.settings.card_bg }};
    --akm-text:      {{ section.settings.text_primary }};
    --akm-muted:     {{ section.settings.text_muted }};
    --akm-accent:    {{ section.settings.accent }};
    --akm-btn-bg:    {{ section.settings.btn_bg }};
    --akm-btn-text:  {{ section.settings.btn_text }};
    --akm-wa-bg:     {{ section.settings.whatsapp_bg }};
    --akm-call-bg:   {{ section.settings.call_bg }};
    --akm-border:    {{ section.settings.border }};
    --akm-trust-bg:  {{ section.settings.trust_card_bg }};
    --akm-spec-bg:   {{ section.settings.spec_card_bg }};

    background: var(--akm-bg);
    color: var(--akm-text);
    direction: rtl;
    padding: 16px 0 56px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .akm-used-car-product *,
  .akm-used-car-product *::before,
  .akm-used-car-product *::after { box-sizing: border-box; }

  .akm-used-car-product .akm-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }

  /* Breadcrumb */
  .akm-used-car-product .akm-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font-size: 13px;
    color: var(--akm-muted);
    margin-bottom: 16px;
  }
  .akm-used-car-product .akm-breadcrumb a {
    color: var(--akm-muted);
    text-decoration: none;
    transition: color .15s ease;
  }
  .akm-used-car-product .akm-breadcrumb a:hover { color: var(--akm-text); }
  .akm-used-car-product .akm-breadcrumb .akm-sep { opacity: .6; }
  .akm-used-car-product .akm-breadcrumb .akm-current {
    color: var(--akm-text);
    font-weight: 600;
  }

  /* Hero */
  .akm-used-car-product .akm-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 28px;
  }

  /* Gallery */
  .akm-used-car-product .akm-gallery-main {
    background: var(--akm-card);
    border: 1px solid var(--akm-border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(15, 23, 42, .04), 0 4px 16px rgba(15, 23, 42, .04);
  }
  .akm-used-car-product .akm-main-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .akm-used-car-product .akm-gallery-thumbs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 10px 2px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .akm-used-car-product .akm-gallery-thumbs::-webkit-scrollbar { height: 6px; }
  .akm-used-car-product .akm-gallery-thumbs::-webkit-scrollbar-thumb {
    background: var(--akm-border);
    border-radius: 6px;
  }
  .akm-used-car-product .akm-thumb {
    flex: 0 0 auto;
    width: 88px;
    height: 66px;
    padding: 0;
    border: 2px solid var(--akm-border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--akm-card);
    cursor: pointer;
    scroll-snap-align: start;
    transition: border-color .15s ease, transform .15s ease;
  }
  .akm-used-car-product .akm-thumb:hover { transform: translateY(-1px); }
  .akm-used-car-product .akm-thumb.is-active { border-color: var(--akm-accent); }
  .akm-used-car-product .akm-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Summary card */
  .akm-used-car-product .akm-summary-card {
    background: linear-gradient(180deg, var(--akm-card) 0%, rgba(248, 250, 252, .82) 100%);
    border: 1px solid var(--akm-border);
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, .04), 0 12px 30px rgba(15, 23, 42, .06);
    position: relative;
    overflow: hidden;
  }
  .akm-used-car-product .akm-summary-card::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    width: 5px;
    height: 100%;
    background: var(--akm-accent);
  }
  .akm-used-car-product .akm-summary-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }
  .akm-used-car-product .akm-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(212, 160, 23, .12);
    color: var(--akm-accent);
    font-size: 12px;
    font-weight: 800;
    padding: 6px 10px;
    border-radius: 999px;
    letter-spacing: .2px;
    white-space: nowrap;
  }
  .akm-used-car-product .akm-title {
    font-size: 22px;
    line-height: 1.35;
    font-weight: 900;
    color: var(--akm-text);
    margin: 0 0 6px;
  }
  .akm-used-car-product .akm-vendor {
    font-size: 13px;
    color: var(--akm-muted);
    margin-bottom: 14px;
  }
  .akm-used-car-product .akm-price-box {
    background: var(--akm-card);
    border: 1px solid var(--akm-border);
    border-radius: 14px;
    padding: 14px;
    margin: 14px 0;
  }
  .akm-used-car-product .akm-price-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: var(--akm-muted);
    margin-bottom: 3px;
  }
  .akm-used-car-product .akm-price {
    font-size: 28px;
    font-weight: 900;
    color: var(--akm-accent);
    letter-spacing: -.4px;
    line-height: 1.25;
  }
  .akm-used-car-product .akm-summary-specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 14px 0;
  }
  .akm-used-car-product .akm-summary-spec {
    background: var(--akm-card);
    border: 1px solid var(--akm-border);
    border-radius: 12px;
    padding: 10px 11px;
    min-height: 70px;
  }
  .akm-used-car-product .akm-summary-spec-label {
    display: block;
    color: var(--akm-muted);
    font-size: 11px;
    font-weight: 700;
    margin-bottom: 3px;
  }
  .akm-used-car-product .akm-summary-spec-value {
    display: block;
    color: var(--akm-text);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.4;
    word-break: break-word;
  }
  .akm-used-car-product .akm-location {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--akm-text);
    background: rgba(212, 160, 23, .08);
    border: 1px solid rgba(212, 160, 23, .22);
    padding: 10px 12px;
    border-radius: 12px;
    margin: 10px 0 14px;
    font-weight: 700;
  }
  .akm-used-car-product .akm-location svg { width: 16px; height: 16px; color: var(--akm-accent); flex-shrink: 0; }
  .akm-used-car-product .akm-summary-trust {
    display: grid;
    gap: 7px;
    margin: 12px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--akm-border);
  }
  .akm-used-car-product .akm-summary-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--akm-text);
    font-size: 12.5px;
    font-weight: 700;
  }
  .akm-used-car-product .akm-summary-trust-item svg {
    width: 16px;
    height: 16px;
    color: var(--akm-accent);
    flex-shrink: 0;
  }

  /* CTA group */
  .akm-used-car-product .akm-cta-group {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 8px;
  }
  .akm-used-car-product .akm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 48px;
    padding: 12px 16px;
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: transform .12s ease, box-shadow .15s ease, opacity .15s ease;
    line-height: 1;
  }
  .akm-used-car-product .akm-btn:hover { transform: translateY(-1px); }
  .akm-used-car-product .akm-btn:active { transform: translateY(0); }
  .akm-used-car-product .akm-btn svg { width: 18px; height: 18px; flex-shrink: 0; }
  .akm-used-car-product .akm-btn-whatsapp {
    background: var(--akm-wa-bg);
    color: #fff;
    box-shadow: 0 4px 14px rgba(37, 211, 102, .25);
  }
  .akm-used-car-product .akm-btn-call {
    background: var(--akm-call-bg);
    color: #fff;
    box-shadow: 0 4px 14px rgba(37, 99, 235, .22);
  }
  .akm-used-car-product .akm-btn-primary {
    background: var(--akm-btn-bg);
    color: var(--akm-btn-text);
    border-color: var(--akm-btn-bg);
  }

  /* Sections */
  .akm-used-car-product .akm-section { margin-bottom: 28px; }
  .akm-used-car-product .akm-section-title {
    font-size: 18px;
    font-weight: 800;
    color: var(--akm-text);
    margin: 0 0 14px;
    position: relative;
    padding-inline-start: 12px;
  }
  .akm-used-car-product .akm-section-title::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 4px;
    bottom: 4px;
    width: 4px;
    background: var(--akm-accent);
    border-radius: 4px;
  }
  .akm-used-car-product .akm-card {
    background: var(--akm-card);
    border: 1px solid var(--akm-border);
    border-radius: 16px;
    padding: 18px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, .03);
  }

  /* Quick specs grid */
  .akm-used-car-product .akm-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .akm-used-car-product .akm-spec-card {
    background: var(--akm-spec-bg);
    border: 1px solid var(--akm-border);
    border-radius: 14px;
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-height: 96px;
  }
  .akm-used-car-product .akm-spec-icon {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--akm-card);
    border: 1px solid var(--akm-border);
    border-radius: 10px;
    color: var(--akm-accent);
  }
  .akm-used-car-product .akm-spec-icon svg { width: 18px; height: 18px; }
  .akm-used-car-product .akm-spec-label {
    font-size: 12px;
    color: var(--akm-muted);
    font-weight: 600;
  }
  .akm-used-car-product .akm-spec-value {
    font-size: 15px;
    color: var(--akm-text);
    font-weight: 700;
    word-break: break-word;
  }

  /* Features */
  .akm-used-car-product .akm-features {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .akm-used-car-product .akm-feature-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--akm-spec-bg);
    color: var(--akm-text);
    border: 1px solid var(--akm-border);
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
  }
  .akm-used-car-product .akm-feature-chip::before {
    content: "";
    width: 6px;
    height: 6px;
    background: var(--akm-accent);
    border-radius: 50%;
  }

  /* Description */
  .akm-used-car-product .akm-description {
    font-size: 15px;
    line-height: 1.85;
    color: var(--akm-text);
    word-wrap: break-word;
  }
  .akm-used-car-product .akm-description p { margin: 0 0 12px; }
  .akm-used-car-product .akm-description p:last-child { margin-bottom: 0; }
  .akm-used-car-product .akm-description ul,
  .akm-used-car-product .akm-description ol {
    padding-inline-start: 22px;
    margin: 0 0 12px;
  }
  .akm-used-car-product .akm-description li { margin-bottom: 6px; }
  .akm-used-car-product .akm-description a {
    color: var(--akm-accent);
    text-decoration: underline;
  }
  .akm-used-car-product .akm-description img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }

  /* Technical details */
  .akm-used-car-product .akm-tech-grid {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--akm-card);
    border: 1px solid var(--akm-border);
    border-radius: 16px;
    overflow: hidden;
  }
  .akm-used-car-product .akm-tech-row {
    display: grid;
    grid-template-columns: minmax(120px, 38%) 1fr;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--akm-border);
    font-size: 14px;
  }
  .akm-used-car-product .akm-tech-row:last-child { border-bottom: 0; }
  .akm-used-car-product .akm-tech-row:nth-child(odd) { background: var(--akm-spec-bg); }
  .akm-used-car-product .akm-tech-label {
    color: var(--akm-muted);
    font-weight: 600;
  }
  .akm-used-car-product .akm-tech-value {
    color: var(--akm-text);
    font-weight: 700;
    word-break: break-word;
  }

  /* ===== Two-column premium layout ===== */
  .akm-used-car-product .akm-detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 8px;
  }

  /* Sidebar: specs, features, trust */
  .akm-used-car-product .akm-detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .akm-used-car-product .akm-sidebar-section {
    background: var(--akm-card);
    border: 1px solid var(--akm-border);
    border-radius: 14px;
    padding: 16px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, .03);
  }
  .akm-used-car-product .akm-sidebar-title {
    font-size: 15px;
    font-weight: 800;
    color: var(--akm-text);
    margin: 0 0 12px;
    padding-inline-start: 10px;
    position: relative;
  }
  .akm-used-car-product .akm-sidebar-title::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 3px;
    bottom: 3px;
    width: 3px;
    background: var(--akm-accent);
    border-radius: 3px;
