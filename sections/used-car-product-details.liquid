{% comment %}
  ============================================================
  AKM — Used Car Product Details  v2
  File: sections/used-car-product-details.liquid
  Dedicated template for used cars only.
  No cart, no checkout, no product form, no inventory language.
  All CSS scoped under .akm-pdp
  ============================================================
{% endcomment %}

{%- liquid
  assign cd = product.metafields.car_details

  assign m_year         = cd.year
  assign m_mileage      = cd.mileage
  assign m_engine       = cd.engine
  assign m_location     = cd.location
  assign m_phone        = cd.phone
  assign m_whatsapp     = cd.whatsapp
  assign m_features     = cd.features

  assign m_condition_mf = product.metafields.shopify["item-condition"].value | default: product.metafields.shopify.item_condition.value
  assign m_condition = m_condition_mf | map: 'label' | join: ' / '
  if m_condition == blank
    assign m_condition = m_condition_mf | map: 'name' | join: ' / '
  endif
  if m_condition == blank
    assign m_condition = m_condition_mf | join: ' / '
  endif
  if m_condition == blank and product.metafields.shopify["item-condition"].value.label != blank
    assign m_condition = product.metafields.shopify["item-condition"].value.label
  endif
  if m_condition == blank and product.metafields.shopify["item-condition"].value.name != blank
    assign m_condition = product.metafields.shopify["item-condition"].value.name
  endif
  if m_condition == blank
    assign m_condition = cd.condition
  endif

  assign m_transmission_mf = product.metafields.shopify["transmission-type"].value | default: product.metafields.shopify.transmission_type.value
  assign m_transmission = m_transmission_mf | map: 'label' | join: ' / '
  if m_transmission == blank
    assign m_transmission = m_transmission_mf | map: 'name' | join: ' / '
  endif
  if m_transmission == blank
    assign m_transmission = m_transmission_mf | join: ' / '
  endif
  if m_transmission == blank and product.metafields.shopify["transmission-type"].value.label != blank
    assign m_transmission = product.metafields.shopify["transmission-type"].value.label
  endif
  if m_transmission == blank and product.metafields.shopify["transmission-type"].value.name != blank
    assign m_transmission = product.metafields.shopify["transmission-type"].value.name
  endif
  if m_transmission == blank
    assign m_transmission = cd.transmission
  endif

  assign m_fuel_mf = product.metafields.shopify["fuel-supply"].value | default: product.metafields.shopify.fuel_supply.value
  assign m_fuel = m_fuel_mf | map: 'label' | join: ' / '
  if m_fuel == blank
    assign m_fuel = m_fuel_mf | map: 'name' | join: ' / '
  endif
  if m_fuel == blank
    assign m_fuel = m_fuel_mf | join: ' / '
  endif
  if m_fuel == blank and product.metafields.shopify["fuel-supply"].value.label != blank
    assign m_fuel = product.metafields.shopify["fuel-supply"].value.label
  endif
  if m_fuel == blank and product.metafields.shopify["fuel-supply"].value.name != blank
    assign m_fuel = product.metafields.shopify["fuel-supply"].value.name
  endif
  if m_fuel == blank
    assign m_fuel = cd.fuel_type
  endif

  assign m_drive_mf = product.metafields.shopify["drive-type"].value | default: product.metafields.shopify.drive_type.value
  assign m_drive = m_drive_mf | map: 'label' | join: ' / '
  if m_drive == blank
    assign m_drive = m_drive_mf | map: 'name' | join: ' / '
  endif
  if m_drive == blank
    assign m_drive = m_drive_mf | join: ' / '
  endif
  if m_drive == blank and product.metafields.shopify["drive-type"].value.label != blank
    assign m_drive = product.metafields.shopify["drive-type"].value.label
  endif
  if m_drive == blank and product.metafields.shopify["drive-type"].value.name != blank
    assign m_drive = product.metafields.shopify["drive-type"].value.name
  endif
  if m_drive == blank
    assign m_drive = cd.drive_type
  endif

  assign m_ext_color_mf = product.metafields.shopify["body-color"].value | default: product.metafields.shopify.body_color.value
  assign m_ext_color = m_ext_color_mf | map: 'label' | join: ' / '
  if m_ext_color == blank
    assign m_ext_color = m_ext_color_mf | map: 'name' | join: ' / '
  endif
  if m_ext_color == blank
    assign m_ext_color = m_ext_color_mf | join: ' / '
  endif
  if m_ext_color == blank and product.metafields.shopify["body-color"].value.label != blank
    assign m_ext_color = product.metafields.shopify["body-color"].value.label
  endif
  if m_ext_color == blank and product.metafields.shopify["body-color"].value.name != blank
    assign m_ext_color = product.metafields.shopify["body-color"].value.name
  endif
  if m_ext_color == blank
    assign m_ext_color = cd.exterior_color
  endif

  assign m_int_color_mf = product.metafields.shopify["upholstery-color"].value | default: product.metafields.shopify.upholstery_color.value
  assign m_int_color = m_int_color_mf | map: 'label' | join: ' / '
  if m_int_color == blank
    assign m_int_color = m_int_color_mf | map: 'name' | join: ' / '
  endif
  if m_int_color == blank
    assign m_int_color = m_int_color_mf | join: ' / '
  endif
  if m_int_color == blank and product.metafields.shopify["upholstery-color"].value.label != blank
    assign m_int_color = product.metafields.shopify["upholstery-color"].value.label
  endif
  if m_int_color == blank and product.metafields.shopify["upholstery-color"].value.name != blank
    assign m_int_color = product.metafields.shopify["upholstery-color"].value.name
  endif
  if m_int_color == blank
    assign m_int_color = cd.interior_color
  endif

  assign m_features_category_mf = product.metafields.shopify["vehicle-features"].value | default: product.metafields.shopify.vehicle_features.value
  assign m_features_category = m_features_category_mf | map: 'label' | join: '، '
  if m_features_category == blank
    assign m_features_category = m_features_category_mf | map: 'name' | join: '، '
  endif
  if m_features_category == blank
    assign m_features_category = m_features_category_mf | join: '، '
  endif

  if m_phone == blank and section.settings.default_phone != blank
    assign m_phone = section.settings.default_phone
  endif
  if m_whatsapp == blank and section.settings.default_whatsapp != blank
    assign m_whatsapp = section.settings.default_whatsapp
  endif

  assign has_tech = false
  if m_engine != blank
    assign has_tech = true
  endif
  if m_drive != blank
    assign has_tech = true
  endif
  if m_fuel != blank
    assign has_tech = true
  endif
  if m_ext_color != blank
    assign has_tech = true
  endif
  if m_int_color != blank
    assign has_tech = true
  endif

  assign whatsapp_clean = m_whatsapp | strip | replace: ' ', '' | replace: '-', '' | replace: '+', '' | replace: '(', '' | replace: ')', ''
  assign phone_clean    = m_phone | strip | replace: ' ', '' | replace: '-', ''

  assign wa_msg_inquiry = 'مرحبًا، أريد الاستفسار عن السيارة: ' | append: product.title
  assign wa_msg_book    = 'مرحبًا، أريد حجز معاينة للسيارة: '   | append: product.title
  assign wa_inquiry_enc = wa_msg_inquiry | url_encode
  assign wa_book_enc    = wa_msg_book    | url_encode

  assign listing_url = section.settings.listing_url
  if listing_url == blank
    assign listing_url = '/pages/سيارات-مستعملة'
  endif

  assign jsonld_price = product.price | money_without_currency | replace: ',', '' | strip
  assign jsonld_desc  = product.description | strip_html | strip | truncate: 500
-%}

<style>
  .akm-pdp {
    --pdp-bg:       {{ section.settings.page_bg }};
    --pdp-card:     {{ section.settings.card_bg }};
    --pdp-ink:      {{ section.settings.text_primary }};
    --pdp-mute:     {{ section.settings.text_muted }};
    --pdp-accent:   {{ section.settings.accent }};
    --pdp-border:   {{ section.settings.border }};
    --pdp-spec-bg:  {{ section.settings.spec_card_bg }};
    --pdp-trust-bg: {{ section.settings.trust_card_bg }};
    --pdp-btn-bg:   {{ section.settings.btn_bg }};
    --pdp-btn-ink:  {{ section.settings.btn_text }};
    --pdp-wa:       {{ section.settings.whatsapp_bg }};
    --pdp-call:     {{ section.settings.call_bg }};
    --pdp-radius:   14px;

    background: var(--pdp-bg);
    color: var(--pdp-ink);
    direction: rtl;
    padding: 20px 0 60px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .akm-pdp *, .akm-pdp *::before, .akm-pdp *::after { box-sizing: border-box; }

  .akm-pdp .pdp-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }

  /* ── Breadcrumb ── */
  .akm-pdp .pdp-crumbs {
    display: flex; flex-wrap: wrap; gap: 6px; align-items: center;
    font-size: 13px; color: var(--pdp-mute); margin-bottom: 18px;
    list-style: none; padding: 0;
  }
  .akm-pdp .pdp-crumbs a { color: var(--pdp-mute); text-decoration: none; }
  .akm-pdp .pdp-crumbs a:hover { color: var(--pdp-ink); }
  .akm-pdp .pdp-crumbs .sep { opacity: .5; }
  .akm-pdp .pdp-crumbs .cur { color: var(--pdp-ink); font-weight: 600; }

  /* ── Hero grid ── */
  .akm-pdp .pdp-hero {
    display: grid; grid-template-columns: 1fr; gap: 20px;
    margin-bottom: 24px;
  }

  /* Gallery */
  .akm-pdp .pdp-gallery-frame {
    background: var(--pdp-card); border: 1px solid var(--pdp-border);
    border-radius: var(--pdp-radius); overflow: hidden;
    box-shadow: 0 2px 12px rgba(15,23,42,.05);
  }
  .akm-pdp .pdp-main-img {
    display: block; width: 100%; height: auto;
    aspect-ratio: 4/3; object-fit: cover;
  }
  .akm-pdp .pdp-thumbs {
    display: flex; gap: 8px; padding: 10px 4px;
    overflow-x: auto; scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .akm-pdp .pdp-thumbs::-webkit-scrollbar { height: 5px; }
  .akm-pdp .pdp-thumbs::-webkit-scrollbar-thumb { background: var(--pdp-border); border-radius: 5px; }
  .akm-pdp .pdp-thumb-btn {
    flex: 0 0 auto; width: 80px; height: 60px; padding: 0;
    border: 2px solid var(--pdp-border); border-radius: 10px;
    overflow: hidden; background: var(--pdp-card); cursor: pointer;
    scroll-snap-align: start; transition: border-color .15s, transform .15s;
  }
  .akm-pdp .pdp-thumb-btn:hover { transform: translateY(-1px); }
  .akm-pdp .pdp-thumb-btn.is-active { border-color: var(--pdp-accent); }
  .akm-pdp .pdp-thumb-btn img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* ── Summary card ── */
  .akm-pdp .pdp-summary {
    background: var(--pdp-card); border: 1px solid var(--pdp-border);
    border-radius: 16px; padding: 22px;
    box-shadow: 0 2px 16px rgba(15,23,42,.06);
    position: relative; overflow: hidden;
  }
  .akm-pdp .pdp-summary::before {
    content: ""; position: absolute; inset-inline-start: 0; top: 0;
    width: 5px; height: 100%; background: var(--pdp-accent);
  }

  .akm-pdp .pdp-condition-badge {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(212,160,23,.1); color: var(--pdp-accent);
    font-size: 12px; font-weight: 800; padding: 5px 10px;
    border-radius: 999px; margin-bottom: 10px;
  }
  .akm-pdp .pdp-condition-badge svg { width: 13px; height: 13px; }

  .akm-pdp .pdp-h1 {
    font-size: 24px; font-weight: 900; line-height: 1.3;
    color: var(--pdp-ink); margin: 0 0 4px;
  }

  .akm-pdp .pdp-vendor {
    font-size: 13px; color: var(--pdp-mute); margin-bottom: 14px;
  }
  .akm-pdp .pdp-vendor strong { color: var(--pdp-ink); font-weight: 700; }

  .akm-pdp .pdp-price-card {
    background: var(--pdp-spec-bg); border: 1px solid var(--pdp-border);
    border-radius: 12px; padding: 14px 16px; margin-bottom: 16px;
  }
  .akm-pdp .pdp-price-label {
    display: block; font-size: 12px; font-weight: 700;
    color: var(--pdp-mute); margin-bottom: 2px;
  }
  .akm-pdp .pdp-price-value {
    font-size: 30px; font-weight: 900; color: var(--pdp-accent);
    letter-spacing: -.5px; line-height: 1.2;
  }

  /* Key specs — 2-col grid inside summary */
  .akm-pdp .pdp-key-specs {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 8px; margin-bottom: 14px;
  }
  .akm-pdp .pdp-ks {
    background: var(--pdp-spec-bg); border: 1px solid var(--pdp-border);
    border-radius: 12px; padding: 12px; display: flex;
    align-items: flex-start; gap: 10px;
  }
  .akm-pdp .pdp-ks-icon {
    width: 34px; height: 34px; flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--pdp-card); border: 1px solid var(--pdp-border);
    border-radius: 10px; color: var(--pdp-accent);
  }
  .akm-pdp .pdp-ks-icon svg { width: 18px; height: 18px; }
  .akm-pdp .pdp-ks-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .akm-pdp .pdp-ks-label {
    font-size: 11px; font-weight: 700; color: var(--pdp-mute);
    line-height: 1.3;
  }
  .akm-pdp .pdp-ks-val {
    font-size: 15px; font-weight: 800; color: var(--pdp-ink);
    line-height: 1.35; word-break: break-word;
  }

  /* Location strip */
  .akm-pdp .pdp-location {
    display: flex; align-items: center; gap: 8px;
    background: rgba(212,160,23,.07); border: 1px solid rgba(212,160,23,.2);
    border-radius: 12px; padding: 10px 12px; margin-bottom: 16px;
    font-size: 13px; font-weight: 700; color: var(--pdp-ink);
  }
  .akm-pdp .pdp-location svg { width: 16px; height: 16px; color: var(--pdp-accent); flex-shrink: 0; }

  /* CTAs */
  .akm-pdp .pdp-ctas {
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
    margin-bottom: 14px;
  }
  .akm-pdp .pdp-ctas .pdp-cta-full { grid-column: 1 / -1; }

  .akm-pdp .pdp-btn {
    display: inline-flex; align-items: center; justify-content: center;
    gap: 8px; width: 100%; min-height: 50px; padding: 12px 14px;
    border: none; border-radius: 12px;
    font-size: 15px; font-weight: 700; text-decoration: none;
    cursor: pointer; transition: transform .12s, box-shadow .15s;
    line-height: 1;
  }
  .akm-pdp .pdp-btn:hover { transform: translateY(-1px); }
  .akm-pdp .pdp-btn:active { transform: translateY(0); }
  .akm-pdp .pdp-btn svg { width: 19px; height: 19px; flex-shrink: 0; }

  .akm-pdp .pdp-btn--wa  { background: var(--pdp-wa); color: #fff; box-shadow: 0 4px 14px rgba(37,211,102,.22); }
  .akm-pdp .pdp-btn--call { background: var(--pdp-call); color: #fff; box-shadow: 0 4px 14px rgba(37,99,235,.2); }
  .akm-pdp .pdp-btn--book { background: var(--pdp-btn-bg); color: var(--pdp-btn-ink); }

  /* Trust bullets */
  .akm-pdp .pdp-trust-list {
    display: flex; flex-direction: column; gap: 6px;
    padding-top: 12px; border-top: 1px solid var(--pdp-border);
  }
  .akm-pdp .pdp-trust-item {
    display: flex; align-items: center; gap: 8px;
    font-size: 12.5px; font-weight: 700; color: var(--pdp-ink);
  }
  .akm-pdp .pdp-trust-item svg { width: 15px; height: 15px; color: var(--pdp-accent); flex-shrink: 0; }

  /* ── Below-fold content ── */
  .akm-pdp .pdp-content {
    display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 4px;
  }

  .akm-pdp .pdp-card {
    background: var(--pdp-card); border: 1px solid var(--pdp-border);
    border-radius: var(--pdp-radius); padding: 20px;
    box-shadow: 0 1px 4px rgba(15,23,42,.03);
  }
  .akm-pdp .pdp-card-title {
    font-size: 17px; font-weight: 800; color: var(--pdp-ink);
    margin: 0 0 14px; padding-inline-start: 12px; position: relative;
  }
  .akm-pdp .pdp-card-title::before {
    content: ""; position: absolute; inset-inline-start: 0;
    top: 3px; bottom: 3px; width: 4px;
    background: var(--pdp-accent); border-radius: 4px;
  }

  /* Tech rows */
  .akm-pdp .pdp-tech-rows { display: flex; flex-direction: column; gap: 0; }
  .akm-pdp .pdp-tech-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 14px; gap: 12px; font-size: 14px;
    border-bottom: 1px solid var(--pdp-border);
  }
  .akm-pdp .pdp-tech-row:last-child { border-bottom: 0; }
  .akm-pdp .pdp-tech-row:nth-child(odd) { background: var(--pdp-spec-bg); border-radius: 8px; }
  .akm-pdp .pdp-tech-lbl { color: var(--pdp-mute); font-weight: 600; flex-shrink: 0; }
  .akm-pdp .pdp-tech-val { color: var(--pdp-ink); font-weight: 700; text-align: end; word-break: break-word; }

  /* Features pills */
  .akm-pdp .pdp-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .akm-pdp .pdp-pill {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--pdp-spec-bg); border: 1px solid var(--pdp-border);
    padding: 7px 13px; border-radius: 999px;
    font-size: 13px; font-weight: 600; color: var(--pdp-ink);
  }
  .akm-pdp .pdp-pill::before {
    content: ""; width: 6px; height: 6px;
    background: var(--pdp-accent); border-radius: 50%;
  }

  /* Description */
  .akm-pdp .pdp-desc {
    font-size: 15px; line-height: 1.85; color: var(--pdp-ink);
    word-wrap: break-word;
  }
  .akm-pdp .pdp-desc p { margin: 0 0 12px; }
  .akm-pdp .pdp-desc p:last-child { margin-bottom: 0; }
  .akm-pdp .pdp-desc ul, .akm-pdp .pdp-desc ol { padding-inline-start: 22px; margin: 0 0 12px; }
  .akm-pdp .pdp-desc li { margin-bottom: 5px; }
  .akm-pdp .pdp-desc a { color: var(--pdp-accent); text-decoration: underline; }
  .akm-pdp .pdp-desc img { max-width: 100%; height: auto; border-radius: 12px; }

  /* Inspection notice */
  .akm-pdp .pdp-notice {
    display: flex; gap: 12px; align-items: flex-start;
    background: rgba(212,160,23,.07); border: 1px solid rgba(212,160,23,.22);
    border-radius: 12px; padding: 14px 16px;
  }
  .akm-pdp .pdp-notice svg { width: 20px; height: 20px; color: var(--pdp-accent); flex-shrink: 0; margin-top: 2px; }
  .akm-pdp .pdp-notice-text { font-size: 13px; line-height: 1.65; color: var(--pdp-ink); }
  .akm-pdp .pdp-notice-text strong { font-weight: 800; color: var(--pdp-accent); }

  /* Bottom CTA */
  .akm-pdp .pdp-bottom-cta {
    background: var(--pdp-card); border: 1px solid var(--pdp-border);
    border-radius: 16px; padding: 20px; margin-top: 4px;
  }
  .akm-pdp .pdp-bottom-cta-title {
    font-size: 17px; font-weight: 800; color: var(--pdp-ink); margin: 0 0 4px;
  }
  .akm-pdp .pdp-bottom-cta-sub {
    font-size: 13px; color: var(--pdp-mute); margin: 0 0 12px;
  }

  /* ── Tablet (640+) ── */
  @media (min-width: 640px) {
    .akm-pdp { padding: 24px 0 64px; }
    .akm-pdp .pdp-h1 { font-size: 26px; }
    .akm-pdp .pdp-price-value { font-size: 32px; }
    .akm-pdp .pdp-key-specs { grid-template-columns: repeat(2, 1fr); }
    .akm-pdp .pdp-thumb-btn { width: 96px; height: 72px; }
  }

  /* ── Desktop (960+) ── */
  @media (min-width: 960px) {
    .akm-pdp .pdp-hero {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: 28px; align-items: start;
    }
    .akm-pdp .pdp-summary { position: sticky; top: 24px; padding: 26px; }
    .akm-pdp .pdp-h1 { font-size: 28px; }
    .akm-pdp .pdp-content {
      grid-template-columns: 1fr 340px; gap: 24px; align-items: start;
    }
    .akm-pdp .pdp-content-side { position: sticky; top: 24px; }
    .akm-pdp .pdp-key-specs { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Mobile (<640) ── */
  @media (max-width: 639px) {
    .akm-pdp {
      padding: 12px 0 40px; width: 100%; max-width: 100%; overflow-x: hidden;
    }
    .akm-pdp .pdp-wrap {
      padding-inline: 12px; width: 100%; max-width: 100%; overflow-x: hidden;
    }
    .akm-pdp .pdp-crumbs { font-size: 12px; margin-bottom: 12px; }
    .akm-pdp .pdp-hero { gap: 14px; margin-bottom: 18px; }

    .akm-pdp .pdp-gallery-frame { border-radius: 12px; }
    .akm-pdp .pdp-main-img { aspect-ratio: 16/10; }
    .akm-pdp .pdp-thumbs { padding: 8px 2px; gap: 6px; }
    .akm-pdp .pdp-thumb-btn { width: 72px; height: 54px; border-radius: 8px; }

    .akm-pdp .pdp-summary {
      position: static; padding: 16px; border-radius: 14px;
      box-shadow: 0 2px 12px rgba(15,23,42,.05);
    }
    .akm-pdp .pdp-summary::before { width: 4px; }

    .akm-pdp .pdp-h1 { font-size: 21px; word-break: break-word; }
    .akm-pdp .pdp-vendor { font-size: 12px; margin-bottom: 10px; }

    .akm-pdp .pdp-price-card { padding: 12px 14px; margin-bottom: 12px; }
    .akm-pdp .pdp-price-value { font-size: clamp(24px, 7vw, 30px); }

    .akm-pdp .pdp-key-specs { grid-template-columns: repeat(2, 1fr); gap: 7px; margin-bottom: 12px; }
    .akm-pdp .pdp-ks { padding: 10px; gap: 8px; border-radius: 10px; }
    .akm-pdp .pdp-ks-icon { width: 30px; height: 30px; border-radius: 8px; }
    .akm-pdp .pdp-ks-icon svg { width: 16px; height: 16px; }
    .akm-pdp .pdp-ks-label { font-size: 10.5px; }
    .akm-pdp .pdp-ks-val { font-size: 14px; }

    .akm-pdp .pdp-location { font-size: 12.5px; padding: 9px 10px; margin-bottom: 12px; }

    .akm-pdp .pdp-ctas { gap: 7px; margin-bottom: 12px; }
    .akm-pdp .pdp-btn { min-height: 46px; font-size: 14px; border-radius: 11px; }

    .akm-pdp .pdp-trust-item { font-size: 12px; }

    .akm-pdp .pdp-content { gap: 14px; }
    .akm-pdp .pdp-card { padding: 16px; border-radius: 13px; }
    .akm-pdp .pdp-card-title { font-size: 15px; margin-bottom: 12px; }
    .akm-pdp .pdp-tech-row { padding: 10px 12px; font-size: 13px; }
    .akm-pdp .pdp-pill { font-size: 12px; padding: 6px 10px; }
    .akm-pdp .pdp-desc { font-size: 14px; }
    .akm-pdp .pdp-notice { padding: 12px 14px; }
    .akm-pdp .pdp-notice-text { font-size: 12.5px; }

    .akm-pdp .pdp-bottom-cta { padding: 16px; border-radius: 13px; }
    .akm-pdp .pdp-bottom-cta-title { font-size: 15px; }

    .akm-pdp .pdp-gallery-frame,
    .akm-pdp .pdp-summary,
    .akm-pdp .pdp-card,
    .akm-pdp .pdp-bottom-cta {
      width: 100%; max-width: 100%; min-width: 0;
    }
    .akm-pdp img, .akm-pdp svg { max-width: 100%; }
  }

  @media (max-width: 380px) {
    .akm-pdp .pdp-wrap { padding-inline: 10px; }
    .akm-pdp .pdp-h1 { font-size: 19px; }
    .akm-pdp .pdp-price-value { font-size: 22px; }
    .akm-pdp .pdp-summary, .akm-pdp .pdp-card, .akm-pdp .pdp-bottom-cta { padding: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .akm-pdp .pdp-btn, .akm-pdp .pdp-thumb-btn { transition: none; }
    .akm-pdp .pdp-btn:hover, .akm-pdp .pdp-thumb-btn:hover { transform: none; }
  }
</style>

<section class="akm-pdp" data-section-id="{{ section.id }}" aria-label="تفاصيل السيارة المستعملة">
  <div class="pdp-wrap">

    {%- comment -%} ── Breadcrumb ── {%- endcomment -%}
    <nav class="pdp-crumbs" aria-label="مسار التصفح">
      <a href="{{ routes.root_url }}">الرئيسية</a>
      <span class="sep">/</span>
      <a href="{{ listing_url }}">سيارات مستعملة</a>
      <span class="sep">/</span>
      <span class="cur">{{ product.title }}</span>
    </nav>

    {%- comment -%} ── Hero: Gallery + Summary ── {%- endcomment -%}
    <div class="pdp-hero">

      {%- comment -%} Gallery {%- endcomment -%}
      <div class="pdp-gallery">
        <div class="pdp-gallery-frame">
          {%- if product.featured_image != blank -%}
            <img class="pdp-main-img" id="akm-img-{{ section.id }}"
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.title | escape }}"
              width="1200" height="900" fetchpriority="high" decoding="async">
          {%- else -%}
            <div class="pdp-main-img" style="display:flex;align-items:center;justify-content:center;background:var(--pdp-spec-bg);color:var(--pdp-mute);">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
            </div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="pdp-thumbs" role="list" aria-label="صور السيارة">
            {%- for image in product.images -%}
              <button type="button"
                class="pdp-thumb-btn{% if forloop.first %} is-active{% endif %}"
                data-src="{{ image | image_url: width: 1200 }}"
                data-alt="{{ product.title | escape }} - {{ forloop.index }}"
                aria-label="صورة {{ forloop.index }}" role="listitem">
                <img src="{{ image | image_url: width: 200 }}"
                  alt="{{ product.title | escape }} - {{ forloop.index }}"
                  width="200" height="150" loading="lazy" decoding="async">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Summary card {%- endcomment -%}
      <aside class="pdp-summary" aria-label="ملخص السيارة">

        {%- if m_condition != blank -%}
          <span class="pdp-condition-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            {{ m_condition }}
          </span>
        {%- endif -%}

        <h1 class="pdp-h1">{{ product.title }}</h1>

        {%- if product.vendor != blank -%}
          <div class="pdp-vendor">البائع: <strong>{{ product.vendor }}</strong></div>
        {%- endif -%}

        <div class="pdp-price-card">
          <span class="pdp-price-label">السعر المطلوب</span>
          <div class="pdp-price-value" aria-label="السعر">{{ product.price | money }}</div>
        </div>

        {%- comment -%} Key specs grid — only cards with real data {%- endcomment -%}
        <div class="pdp-key-specs" aria-label="المواصفات الأساسية">
          {%- if m_condition != blank -%}
            <div class="pdp-ks">
              <span class="pdp-ks-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              </span>
              <span class="pdp-ks-text">
                <span class="pdp-ks-label">الحالة</span>
                <span class="pdp-ks-val">{{ m_condition }}</span>
              </span>
            </div>
          {%- endif -%}

          {%- if m_year != blank -%}
            <div class="pdp-ks">
              <span class="pdp-ks-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </span>
              <span class="pdp-ks-text">
                <span class="pdp-ks-label">سنة الصنع</span>
                <span class="pdp-ks-val">{{ m_year }}</span>
              </span>
            </div>
          {%- endif -%}

          {%- if m_mileage != blank -%}
            <div class="pdp-ks">
              <span class="pdp-ks-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9"/><path d="M12 12l4-4"/><circle cx="12" cy="12" r=".5" fill="currentColor"/></svg>
              </span>
              <span class="pdp-ks-text">
                <span class="pdp-ks-label">الكيلومترات</span>
                <span class="pdp-ks-val">{{ m_mileage }}</span>
              </span>
            </div>
          {%- endif -%}

          {%- if m_transmission != blank -%}
            <div class="pdp-ks">
              <span class="pdp-ks-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M6 8v10M18 8v3a3 3 0 0 1-3 3h-3M12 14V8"/></svg>
              </span>
              <span class="pdp-ks-text">
                <span class="pdp-ks-label">ناقل الحركة</span>
                <span class="pdp-ks-val">{{ m_transmission }}</span>
              </span>
            </div>
          {%- endif -%}

          {%- if m_location != blank -%}
            <div class="pdp-ks">
              <span class="pdp-ks-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <span class="pdp-ks-text">
                <span class="pdp-ks-label">الموقع</span>
                <span class="pdp-ks-val">{{ m_location }}</span>
              </span>
            </div>
          {%- endif -%}
        </div>

        {%- if m_location != blank -%}
          <div class="pdp-location">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>متاحة للمعاينة في {{ m_location }}</span>
          </div>
        {%- endif -%}

        {%- comment -%} CTA buttons {%- endcomment -%}
        <div class="pdp-ctas">
          {%- if m_whatsapp != blank -%}
            <a class="pdp-btn pdp-btn--wa"
               href="https://wa.me/{{ whatsapp_clean }}?text={{ wa_inquiry_enc }}"
               target="_blank" rel="noopener nofollow" aria-label="تواصل عبر واتساب">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.889 9.884"/></svg>
              <span>واتساب</span>
            </a>
          {%- endif -%}

          {%- if m_phone != blank -%}
            <a class="pdp-btn pdp-btn--call"
               href="tel:{{ phone_clean }}" aria-label="اتصل بنا">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.8.36 1.58.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c1.23.34 2.01.58 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>اتصل الآن</span>
            </a>
          {%- endif -%}

          {%- if m_whatsapp != blank -%}
            <a class="pdp-btn pdp-btn--book pdp-cta-full"
               href="https://wa.me/{{ whatsapp_clean }}?text={{ wa_book_enc }}"
               target="_blank" rel="noopener nofollow" aria-label="احجز معاينة عبر واتساب">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span>احجز معاينة</span>
            </a>
          {%- endif -%}
        </div>

        <div class="pdp-trust-list" aria-label="ضمانات">
          <div class="pdp-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span>فحص متاح قبل الشراء</span>
          </div>
          <div class="pdp-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span>صور أصلية بدون فلاتر</span>
          </div>
          <div class="pdp-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span>تواصل مباشر مع AKM</span>
          </div>
        </div>

      </aside>
    </div>

    {%- comment -%} ── Below-fold: two-column on desktop ── {%- endcomment -%}

    {%- comment -%} Collect features {%- endcomment -%}
    {%- liquid
      assign features_collected = ''

      if m_features_category != blank
        assign farr_category = m_features_category | split: '، '
        for f in farr_category
          assign fc = f | strip
          if fc != blank
            assign features_collected = features_collected | append: fc | append: '|||'
          endif
        endfor
      endif

      if m_features != blank
        assign mf_type = m_features.type
        if mf_type contains 'list'
          for f in m_features.value
            assign fc = f | strip
            if fc != blank
              assign features_collected = features_collected | append: fc | append: '|||'
            endif
          endfor
        else
          assign fstr = m_features.value | strip
          if fstr contains ','
            assign farr = fstr | split: ','
          else
            assign farr = fstr | newline_to_br | split: '<br />'
          endif
          for f in farr
            assign fc = f | strip | replace: '<br>', '' | replace: '<br/>', '' | replace: '<br />', ''
            if fc != blank
              assign features_collected = features_collected | append: fc | append: '|||'
            endif
          endfor
        endif
      endif

      for tag in product.tags
        assign tl = tag | downcase | strip
        assign skip = false
        if tl == 'used cars' or tl == 'used-car' or tl == 'used car' or tl == 'used' or tl == 'new' or tl == 'سيارات مستعملة' or tl == 'مستعمل' or tl == 'مستعملة'
          assign skip = true
        endif
        if tag contains ':'
          assign skip = true
        endif
        unless skip
          assign features_collected = features_collected | append: tag | append: '|||'
        endunless
      endfor

      assign features_array = features_collected | split: '|||'
    -%}

    <div class="pdp-content">

      {%- comment -%} Main column {%- endcomment -%}
      <div class="pdp-content-main">

        {%- if product.description != blank -%}
          <div class="pdp-card">
            <h2 class="pdp-card-title" id="akm-overview-{{ section.id }}">نظرة عامة على السيارة</h2>
            <div class="pdp-desc rte">{{ product.description }}</div>
          </div>
        {%- endif -%}

        {%- comment -%} Inspection notice {%- endcomment -%}
        <div class="pdp-card">
          <div class="pdp-notice">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <div class="pdp-notice-text">
              <strong>هام:</strong> ننصح بمعاينة السيارة شخصيًا والتأكد من حالتها قبل اتخاذ قرار الشراء. يمكنك حجز موعد للمعاينة عبر واتساب أو الاتصال المباشر.
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} Side column: tech + features {%- endcomment -%}
      <div class="pdp-content-side">

        {%- if has_tech -%}
          <div class="pdp-card">
            <h2 class="pdp-card-title" id="akm-tech-{{ section.id }}">المواصفات الفنية</h2>
            <div class="pdp-tech-rows">
              {%- if m_engine != blank -%}
                <div class="pdp-tech-row">
                  <span class="pdp-tech-lbl">المحرك</span>
                  <span class="pdp-tech-val">{{ m_engine }}</span>
                </div>
              {%- endif -%}
              {%- if m_drive != blank -%}
                <div class="pdp-tech-row">
                  <span class="pdp-tech-lbl">نظام الدفع</span>
                  <span class="pdp-tech-val">{{ m_drive }}</span>
                </div>
              {%- endif -%}
              {%- if m_fuel != blank -%}
                <div class="pdp-tech-row">
                  <span class="pdp-tech-lbl">نوع الوقود</span>
                  <span class="pdp-tech-val">{{ m_fuel }}</span>
                </div>
              {%- endif -%}
              {%- if m_transmission != blank -%}
                <div class="pdp-tech-row">
                  <span class="pdp-tech-lbl">ناقل الحركة</span>
                  <span class="pdp-tech-val">{{ m_transmission }}</span>
                </div>
              {%- endif -%}
              {%- if m_ext_color != blank -%}
                <div class="pdp-tech-row">
                  <span class="pdp-tech-lbl">اللون الخارجي</span>
                  <span class="pdp-tech-val">{{ m_ext_color }}</span>
                </div>
              {%- endif -%}
              {%- if m_int_color != blank -%}
                <div class="pdp-tech-row">
                  <span class="pdp-tech-lbl">اللون الداخلي</span>
                  <span class="pdp-tech-val">{{ m_int_color }}</span>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if features_array.size > 0 -%}
          <div class="pdp-card" style="margin-top: 16px;">
            <h2 class="pdp-card-title" id="akm-features-{{ section.id }}">مميزات إضافية</h2>
            <div class="pdp-pills">
              {%- assign seen = '|||' -%}
              {%- for f in features_array -%}
                {%- assign f_trim = f | strip -%}
                {%- assign key = '|||' | append: f_trim | append: '|||' -%}
                {%- unless f_trim == blank or seen contains key -%}
                  <span class="pdp-pill">{{ f_trim }}</span>
                  {%- assign seen = seen | append: f_trim | append: '|||' -%}
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

      </div>

    </div>

    {%- comment -%} ── Bottom CTA ── {%- endcomment -%}
    {%- if m_whatsapp != blank or m_phone != blank -%}
      <div class="pdp-bottom-cta">
        <h2 class="pdp-bottom-cta-title">مهتم بهذه السيارة؟</h2>
        <p class="pdp-bottom-cta-sub">تواصل معنا لترتيب موعد المعاينة.</p>
        <div class="pdp-ctas">
          {%- if m_whatsapp != blank -%}
            <a class="pdp-btn pdp-btn--wa"
               href="https://wa.me/{{ whatsapp_clean }}?text={{ wa_inquiry_enc }}"
               target="_blank" rel="noopener nofollow" aria-label="واتساب">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.889 9.884"/></svg>
              <span>واتساب</span>
            </a>
          {%- endif -%}
          {%- if m_phone != blank -%}
            <a class="pdp-btn pdp-btn--call"
               href="tel:{{ phone_clean }}" aria-label="اتصل">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.8.36 1.58.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c1.23.34 2.01.58 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>اتصل الآن</span>
            </a>
          {%- endif -%}
          {%- if m_whatsapp != blank -%}
            <a class="pdp-btn pdp-btn--book pdp-cta-full"
               href="https://wa.me/{{ whatsapp_clean }}?text={{ wa_book_enc }}"
               target="_blank" rel="noopener nofollow" aria-label="احجز معاينة">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span>احجز معاينة</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} ── JSON-LD structured data ── {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }}{% if product.images.size > 0 %},
  "image": [
    {%- for image in product.images limit: 6 -%}
      {{ image | image_url: width: 1600 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]{% endif %}{% if jsonld_desc != blank %},
  "description": {{ jsonld_desc | json }}{% endif %}{% if product.vendor != blank %},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  }{% endif %}{% if m_year != blank %},
  "productionDate": {{ m_year | json }}{% endif %}{% if m_ext_color != blank %},
  "color": {{ m_ext_color | json }}{% endif %},
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: product.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ jsonld_price }}",
    "itemCondition": "https://schema.org/UsedCondition"{% if product.vendor != blank %},
    "seller": {
      "@type": "Organization",
      "name": {{ product.vendor | json }}
    }{% endif %}
  }
}
</script>

<script>
(function () {
  var sec = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!sec) return;
  var img = sec.querySelector('#akm-img-{{ section.id }}');
  var thumbs = sec.querySelectorAll('.pdp-thumb-btn');
  if (!img || !thumbs.length) return;
  thumbs.forEach(function (b) {
    b.addEventListener('click', function () {
      var s = b.dataset.src, a = b.dataset.alt;
      if (s) img.src = s;
      if (a) img.alt = a;
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
      b.classList.add('is-active');
    });
  });
})();
</script>

