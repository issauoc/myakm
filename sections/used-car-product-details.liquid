{%- comment %} ===== JSON-LD: Product schema (real visible data only) ===== {%- endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }}{% if product.images.size > 0 %},
  "image": [
    {%- for image in product.images limit: 6 -%}
      {{ image | image_url: width: 1600 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]{% endif %}{% if jsonld_desc != blank %},
  "description": {{ jsonld_desc | json }}{% endif %}{% if product.vendor != blank %},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  }{% endif %}{% if m_year != blank %},
  "productionDate": {{ m_year | json }}{% endif %}{% if m_ext_color != blank %},
  "color": {{ m_ext_color | json }}{% endif %},
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: product.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ jsonld_price }}",
    "itemCondition": "https://schema.org/UsedCondition"{% if product.vendor != blank %},
    "seller": {
      "@type": "Organization",
      "name": {{ product.vendor | json }}
    }{% endif %}
  }
}
</script>

<script>
  (function () {
    var sectionEl = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!sectionEl) return;

    var mainImg = sectionEl.querySelector('#akm-main-img-{{ section.id }}');
    var thumbs  = sectionEl.querySelectorAll('.akm-thumb');
    if (!mainImg || !thumbs.length) return;

    thumbs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var src = btn.getAttribute('data-src');
        var alt = btn.getAttribute('data-alt');
        if (src) mainImg.src = src;
        if (alt) mainImg.alt = alt;
        thumbs.forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
      });

      btn.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          btn.click();
        }
      });
    });
  })();
</script>

