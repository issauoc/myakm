<section class="akm-used-car-product" data-section-id="{{ section.id }}" aria-label="تفاصيل السيارة المستعملة">
  <div class="akm-container">

    {%- comment %} ===== Breadcrumb / back to listing ===== {%- endcomment %}
    <nav class="akm-breadcrumb" aria-label="مسار التصفح">
      <a href="{{ routes.root_url }}">الرئيسية</a>
      <span class="akm-sep">/</span>
      <a href="{{ listing_url }}">سيارات مستعملة</a>
      <span class="akm-sep">/</span>
      <span class="akm-current">{{ product.title }}</span>
    </nav>

    {%- comment %} ===== Hero: Gallery + Summary ===== {%- endcomment %}
    <div class="akm-hero">

      <div class="akm-gallery">
        <div class="akm-gallery-main">
          {%- if product.featured_image != blank -%}
            <img
              class="akm-main-img"
              id="akm-main-img-{{ section.id }}"
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.title | escape }}"
              width="1200"
              height="900"
              fetchpriority="high"
              decoding="async">
          {%- else -%}
            <div class="akm-main-img" style="display:flex;align-items:center;justify-content:center;background:var(--akm-spec-bg);color:var(--akm-muted);">
              {{ 'product-1' | placeholder_svg_tag: 'akm-placeholder' }}
            </div>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="akm-gallery-thumbs" role="list" aria-label="معرض صور السيارة">
            {%- for image in product.images -%}
              <button
                type="button"
                class="akm-thumb{% if forloop.first %} is-active{% endif %}"
                data-src="{{ image | image_url: width: 1200 }}"
                data-alt="{{ product.title | escape }} - صورة {{ forloop.index }}"
                data-target="akm-main-img-{{ section.id }}"
                aria-label="عرض الصورة رقم {{ forloop.index }}"
                role="listitem">
                <img
                  src="{{ image | image_url: width: 220 }}"
                  alt="{{ product.title | escape }} - صورة {{ forloop.index }}"
                  width="220"
                  height="165"
                  loading="lazy"
                  decoding="async">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <aside class="akm-summary" aria-label="ملخص السيارة">
        <div class="akm-summary-card">

          {%- if m_condition != blank -%}
            <span class="akm-badge">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              {{ m_condition }}
            </span>
          {%- endif -%}

          <h1 class="akm-title">{{ product.title }}</h1>

          {%- if product.vendor != blank -%}
            <div class="akm-vendor">{{ product.vendor }}</div>
          {%- endif -%}

          <div class="akm-price-box">
            <span class="akm-price-label">السعر المطلوب</span>
            <div class="akm-price" aria-label="السعر">{{ product.price | money }}</div>
          </div>

          <div class="akm-summary-specs" aria-label="ملخص مواصفات السيارة">
            <div class="akm-summary-spec">
              <span class="akm-summary-spec-label">سنة الصنع</span>
              <span class="akm-summary-spec-value">{% if m_year != blank %}{{ m_year }}{% else %}غير محدد{% endif %}</span>
            </div>
            <div class="akm-summary-spec">
              <span class="akm-summary-spec-label">الحالة</span>
              <span class="akm-summary-spec-value">{% if m_condition != blank %}{{ m_condition }}{% else %}مستعملة{% endif %}</span>
            </div>
            <div class="akm-summary-spec">
              <span class="akm-summary-spec-label">الكيلومترات</span>
              <span class="akm-summary-spec-value">{% if m_mileage != blank %}{{ m_mileage }}{% else %}غير محدد{% endif %}</span>
            </div>
            <div class="akm-summary-spec">
              <span class="akm-summary-spec-label">ناقل الحركة</span>
              <span class="akm-summary-spec-value">{% if m_transmission != blank %}{{ m_transmission }}{% else %}غير محدد{% endif %}</span>
            </div>
            <div class="akm-summary-spec">
              <span class="akm-summary-spec-label">نوع الوقود</span>
              <span class="akm-summary-spec-value">{% if m_fuel != blank %}{{ m_fuel }}{% else %}غير محدد{% endif %}</span>
            </div>
            <div class="akm-summary-spec">
              <span class="akm-summary-spec-label">الموقع</span>
              <span class="akm-summary-spec-value">{% if m_location != blank %}{{ m_location }}{% else %}AKM Egypt{% endif %}</span>
            </div>
          </div>

          <div class="akm-location">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{% if m_location != blank %}متاحة للمعاينة في {{ m_location }}{% else %}متاحة للمعاينة لدى AKM{% endif %}</span>
          </div>

          <div class="akm-cta-group">
            {%- if m_whatsapp != blank -%}
              <a class="akm-btn akm-btn-whatsapp"
                 href="https://wa.me/{{ whatsapp_clean }}?text={{ wa_inquiry_enc }}"
                 target="_blank" rel="noopener nofollow"
                 aria-label="تواصل عبر واتساب">
